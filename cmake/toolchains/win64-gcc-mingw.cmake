set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(CMAKE_C_LINK_DEPENDS_USE_LINKER FALSE)
set(CMAKE_CXX_LINK_DEPENDS_USE_LINKER FALSE)

set(_san4_tc_root "${CMAKE_CURRENT_LIST_DIR}/../..")
file(REAL_PATH "${_san4_tc_root}" _san4_tc_root)

set(_mingw_cand "")
if(DEFINED SAN4_MINGW_SYSROOT AND NOT "${SAN4_MINGW_SYSROOT}" STREQUAL "")
  set(_mingw_cand "${SAN4_MINGW_SYSROOT}")
elseif(DEFINED ENV{SAN4_MINGW_SYSROOT} AND NOT "$ENV{SAN4_MINGW_SYSROOT}" STREQUAL "")
  set(_mingw_cand "$ENV{SAN4_MINGW_SYSROOT}")
elseif(EXISTS "${_san4_tc_root}/third_party/mingw64/usr/x86_64-w64-mingw32")
  set(_mingw_cand "${_san4_tc_root}/third_party/mingw64/usr")
elseif(EXISTS "/usr/x86_64-w64-mingw32")
  set(_mingw_cand "/usr")
elseif(EXISTS "/mingw64/x86_64-w64-mingw32")
  set(_mingw_cand "/mingw64")
endif()

set(_mingw_usr "${_mingw_cand}")
if(_mingw_cand AND EXISTS "${_mingw_cand}/usr/x86_64-w64-mingw32")
  set(_mingw_usr "${_mingw_cand}/usr")
endif()

set(_mingw_search_paths "")
if(_mingw_usr AND EXISTS "${_mingw_usr}/bin")
  list(APPEND _mingw_search_paths "${_mingw_usr}/bin")
endif()

if(NOT CMAKE_C_COMPILER)
  find_program(_tc_gcc NAMES x86_64-w64-mingw32-gcc-posix x86_64-w64-mingw32-gcc HINTS ${_mingw_search_paths})
  if(_tc_gcc)
    set(CMAKE_C_COMPILER "${_tc_gcc}" CACHE FILEPATH "MinGW C compiler" FORCE)
  endif()
  unset(_tc_gcc CACHE)
endif()

if(NOT CMAKE_CXX_COMPILER)
  find_program(_tc_gxx NAMES x86_64-w64-mingw32-g++-posix x86_64-w64-mingw32-g++ HINTS ${_mingw_search_paths})
  if(_tc_gxx)
    set(CMAKE_CXX_COMPILER "${_tc_gxx}" CACHE FILEPATH "MinGW CXX compiler" FORCE)
  endif()
  unset(_tc_gxx CACHE)
endif()

if(NOT CMAKE_RC_COMPILER)
  find_program(_tc_rc NAMES x86_64-w64-mingw32-windres windres llvm-windres-21 llvm-windres HINTS ${_mingw_search_paths})
  if(_tc_rc)
    set(CMAKE_RC_COMPILER "${_tc_rc}" CACHE FILEPATH "MinGW RC compiler" FORCE)
  endif()
  unset(_tc_rc CACHE)
endif()

find_program(_tc_ar NAMES x86_64-w64-mingw32-ar HINTS ${_mingw_search_paths})
if(_tc_ar)
  set(CMAKE_AR "${_tc_ar}" CACHE FILEPATH "MinGW archiver" FORCE)
endif()
unset(_tc_ar CACHE)

find_program(_tc_ranlib NAMES x86_64-w64-mingw32-ranlib HINTS ${_mingw_search_paths})
if(_tc_ranlib)
  set(CMAKE_RANLIB "${_tc_ranlib}" CACHE FILEPATH "MinGW ranlib" FORCE)
endif()
unset(_tc_ranlib CACHE)

find_program(_tc_strip NAMES x86_64-w64-mingw32-strip llvm-strip-21 llvm-strip HINTS ${_mingw_search_paths})
if(_tc_strip)
  set(CMAKE_STRIP "${_tc_strip}" CACHE FILEPATH "MinGW strip" FORCE)
endif()
unset(_tc_strip CACHE)

if(_mingw_usr AND EXISTS "${_mingw_usr}/x86_64-w64-mingw32")
  if(NOT "${_mingw_usr}" STREQUAL "/usr")
    set(_reloc_flags "-B${_mingw_usr}/bin -B${_mingw_usr}/x86_64-w64-mingw32/bin")
    set(CMAKE_C_FLAGS_INIT "${_reloc_flags}")
    set(CMAKE_CXX_FLAGS_INIT "${_reloc_flags}")
  endif()
  set(CMAKE_RC_FLAGS_INIT "-I${_mingw_usr}/x86_64-w64-mingw32/include")
  set(CMAKE_FIND_ROOT_PATH "${_mingw_usr}/x86_64-w64-mingw32" "${_mingw_usr}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
