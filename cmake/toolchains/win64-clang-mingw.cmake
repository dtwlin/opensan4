set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

# LLD's MinGW COFF driver (ld.lld -m i386pep) does not accept GNU ld's
# --dependency-file=... flag emitted by CMake 4.x.
set(CMAKE_C_LINK_DEPENDS_USE_LINKER FALSE)
set(CMAKE_CXX_LINK_DEPENDS_USE_LINKER FALSE)

set(_san4_tc_root "${CMAKE_CURRENT_LIST_DIR}/../..")
file(REAL_PATH "${_san4_tc_root}" _san4_tc_root)

set(_mingw_cand "")
if(DEFINED SAN4_MINGW_SYSROOT AND NOT "${SAN4_MINGW_SYSROOT}" STREQUAL "")
  set(_mingw_cand "${SAN4_MINGW_SYSROOT}")
elseif(DEFINED ENV{SAN4_MINGW_SYSROOT} AND NOT "$ENV{SAN4_MINGW_SYSROOT}" STREQUAL "")
  set(_mingw_cand "$ENV{SAN4_MINGW_SYSROOT}")
elseif(EXISTS "${_san4_tc_root}/third_party/mingw64/usr/x86_64-w64-mingw32")
  set(_mingw_cand "${_san4_tc_root}/third_party/mingw64/usr")
elseif(EXISTS "/usr/x86_64-w64-mingw32")
  set(_mingw_cand "/usr")
elseif(EXISTS "/mingw64/x86_64-w64-mingw32")
  set(_mingw_cand "/mingw64")
endif()

set(_mingw_usr "${_mingw_cand}")
if(_mingw_cand AND EXISTS "${_mingw_cand}/usr/x86_64-w64-mingw32")
  set(_mingw_usr "${_mingw_cand}/usr")
endif()

if(NOT CMAKE_C_COMPILER OR NOT CMAKE_CXX_COMPILER)
  foreach(_sfx IN ITEMS "" -23 -22 -21 -20 -19 -18 -17 -16 -15)
    find_program(_tc_cc NAMES "clang${_sfx}")
    find_program(_tc_cxx NAMES "clang++${_sfx}")
    if(_tc_cc AND _tc_cxx)
      set(CMAKE_C_COMPILER "${_tc_cc}" CACHE FILEPATH "C compiler" FORCE)
      set(CMAKE_CXX_COMPILER "${_tc_cxx}" CACHE FILEPATH "CXX compiler" FORCE)
      unset(_tc_cc CACHE)
      unset(_tc_cxx CACHE)
      break()
    endif()
    unset(_tc_cc CACHE)
    unset(_tc_cxx CACHE)
  endforeach()
endif()

if(CMAKE_CXX_COMPILER)
  file(REAL_PATH "${CMAKE_CXX_COMPILER}" _tc_clang_real)
  get_filename_component(_tc_llvm_bin "${_tc_clang_real}" DIRECTORY)
  if(EXISTS "${_tc_llvm_bin}/llvm-ar")
    set(CMAKE_AR "${_tc_llvm_bin}/llvm-ar" CACHE FILEPATH "LLVM archiver" FORCE)
    set(CMAKE_C_COMPILER_AR "${_tc_llvm_bin}/llvm-ar" CACHE FILEPATH "LLVM C archiver" FORCE)
    set(CMAKE_CXX_COMPILER_AR "${_tc_llvm_bin}/llvm-ar" CACHE FILEPATH "LLVM CXX archiver" FORCE)
  endif()
  if(EXISTS "${_tc_llvm_bin}/llvm-ranlib")
    set(CMAKE_RANLIB "${_tc_llvm_bin}/llvm-ranlib" CACHE FILEPATH "LLVM ranlib" FORCE)
    set(CMAKE_C_COMPILER_RANLIB "${_tc_llvm_bin}/llvm-ranlib" CACHE FILEPATH "LLVM C ranlib" FORCE)
    set(CMAKE_CXX_COMPILER_RANLIB "${_tc_llvm_bin}/llvm-ranlib" CACHE FILEPATH "LLVM CXX ranlib" FORCE)
  endif()
  if(EXISTS "${_tc_llvm_bin}/llvm-windres")
    set(CMAKE_RC_COMPILER "${_tc_llvm_bin}/llvm-windres" CACHE FILEPATH "LLVM windres" FORCE)
  endif()
  if(EXISTS "${_tc_llvm_bin}/llvm-strip")
    set(CMAKE_STRIP "${_tc_llvm_bin}/llvm-strip" CACHE FILEPATH "LLVM strip" FORCE)
  endif()
  if(EXISTS "${_tc_llvm_bin}/ld.lld")
    set(_tc_lld_flags "-fuse-ld=lld --ld-path=${_tc_llvm_bin}/ld.lld")
  endif()
endif()

if(NOT CMAKE_RC_COMPILER)
  find_program(_tc_rc NAMES llvm-windres-23 llvm-windres-22 llvm-windres-21 llvm-windres-20 llvm-windres-19 llvm-windres x86_64-w64-mingw32-windres windres)
  if(_tc_rc)
    set(CMAKE_RC_COMPILER "${_tc_rc}" CACHE FILEPATH "RC compiler" FORCE)
  endif()
  unset(_tc_rc CACHE)
endif()

set(CMAKE_C_COMPILER_TARGET x86_64-w64-mingw32)
set(CMAKE_CXX_COMPILER_TARGET x86_64-w64-mingw32)

if(_mingw_usr AND EXISTS "${_mingw_usr}/x86_64-w64-mingw32")
  set(CMAKE_SYSROOT "${_mingw_usr}")
  set(CMAKE_C_FLAGS_INIT "--target=x86_64-w64-mingw32 --sysroot=${_mingw_usr}")
  set(CMAKE_CXX_FLAGS_INIT "--target=x86_64-w64-mingw32 --sysroot=${_mingw_usr}")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tc_lld_flags}")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_tc_lld_flags}")
  set(CMAKE_RC_FLAGS_INIT "--target=pe-x86-64 -I${_mingw_usr}/x86_64-w64-mingw32/include")
  set(CMAKE_FIND_ROOT_PATH "${_mingw_usr}/x86_64-w64-mingw32" "${_mingw_usr}")
else()
  set(CMAKE_C_FLAGS_INIT "--target=x86_64-w64-mingw32")
  set(CMAKE_CXX_FLAGS_INIT "--target=x86_64-w64-mingw32")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tc_lld_flags}")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_tc_lld_flags}")
  set(CMAKE_RC_FLAGS_INIT "--target=pe-x86-64")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
